#!/usr/bin/env bash

set -e

real_ld="/c/Program Files (x86)/Android/AndroidNDK/android-ndk-r23c/toolchains/llvm/prebuilt/windows-x86_64/bin/ld.lld.exe"
compat_script="/e/project_learning/ucore/ucore-master/labcodes_answer/lab8_result/target/native/compat/user.ld"

args=()
replace_script=0
for arg in "$@"; do
    if [[ "$arg" == "tools/user.ld" ]]; then
        args+=("$compat_script")
        replace_script=1
    else
        args+=("$arg")
    fi
done

exec "$real_ld" "${args[@]}"
